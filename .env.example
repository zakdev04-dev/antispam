# Telegram Bot Token (BotFather dan olingan)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# MongoDB ulanish havolasi (MongoDB Atlas yoki local)
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/anti_spam_bot?retryWrites=true&w=majority

# Bot administratorlarining Telegram ID lari (vergul bilan ajrating)
ADMINS=123456789,987654321

# Render.com yoki Server porti (Render avtomatik PORT beradi)
PORT=8080

# Video qo'llanma narxi (UZS da, standart 15000)
VIDEO_PRICE=15000

# Vazifadan 30 kun ichida chiqib ketganda jarima (qo'shimcha 250 UZS)
PENALTY_FEE=250
